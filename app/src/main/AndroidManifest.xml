<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Shizuku libraries declare minSdk 24 -->
    <uses-sdk tools:overrideLibrary="rikka.shizuku.api, rikka.shizuku.provider" />

    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="PackageVisibilityPolicy,QueryAllPackagesPermission" />
    <!-- Used to swap and restore the secure "assistant" setting. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".ActivityManagerApplication"
        android:allowBackup="true"
        android:banner="@mipmap/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_descriptor"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="GoogleAppIndexingWarning">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".tv.TvActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <!--<category android:name="android.intent.category.LEANBACK_LAUNCHER" />-->
            </intent-filter>
        </activity>

        <activity
            android:name=".intent.IntentBuilderActivity"
            android:exported="true"
            android:label="@string/intent_launcher_activity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".intent.analyzer.IntentAnalyzerActivity"
            android:exported="false"
            android:label="@string/intent_analyzer_activity" />

        <!--
            System wide intent interceptor. Ships disabled so the analyzer stays out of the share
            and open dialogs until the user turns it on in the settings, which flips this component
            through PackageManager.setComponentEnabledSetting. See IntentInterceptor.
        -->
        <activity-alias
            android:name=".intent.analyzer.IntentInterceptorActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/intent_analyzer_activity"
            android:targetActivity=".intent.analyzer.IntentAnalyzerActivity">

            <!-- Anything shared from another application. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Typed payloads: content and file uris, and intents that carry a type only. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <action android:name="android.intent.action.PICK" />
                <action android:name="android.intent.action.GET_CONTENT" />
                <action android:name="android.intent.action.ATTACH_DATA" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />

                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Untyped uris: links and custom schemes. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:scheme="ftp" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:scheme="market" />
                <data android:scheme="intent" />
                <data android:scheme="package" />
                <data android:scheme="geo" />
                <data android:scheme="tel" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mailto" />
            </intent-filter>

            <!-- Text selection toolbar. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>

            <!--
                No catch-all filter for intents without data or a type: nothing else in the system
                declares one, so the alias would become the sole match and the chooser would be
                skipped, silently swallowing every such intent.
            -->

        </activity-alias>

        <activity
            android:name=".intent.history.HistoryActivity"
            android:exported="true"
            android:label="@string/history_activity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".manifest.ManifestViewerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".app.ActivitiesListActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".shortcut.CreateShortcutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".shortcut.ShortcutHandlerActivity"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=".shortcut"
            android:theme="@android:style/Theme.Translucent" />

        <activity
            android:name=".about.AboutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".preferences.SettingsActivity"
            android:exported="false"
            android:label="@string/action_settings" />

        <activity
            android:name=".onboarding.ShizukuOnboardingActivity"
            android:exported="false"
            android:label="@string/onboarding_title" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            tools:ignore="ExportedContentProvider" />

    </application>

</manifest>
